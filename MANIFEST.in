include README.md README.zh-CN.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include CODE_OF_CONDUCT.md LICENSE NOTICE.md DATA_NOTICE.md
include Dockerfile docker-compose.yml .dockerignore
recursive-include docs *.md
recursive-include tests *.py
prune .github
exclude .gitignore .pre-commit-config.yaml
global-exclude __pycache__ *.py[cod] *.db *.sqlite *.sqlite3 .env
